from view import *
from model import *
import math

n = 20
particles = []
x_start = -1
mass = 90000
for i in range(n):
    u = Vec(x_start, 0)
    x_start = x_start+0.1
    pos = 10 * u
    vel = -1 * u 
    particles.append(Particle(mass,pos,vel,0.2))
    mass = mass - 1000

simulation_loop(constant_gravitational_field, 0.0005, particles)

